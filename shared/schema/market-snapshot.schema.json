{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://delta-force-map/shared/schema/market-snapshot.schema.json",
  "title": "AmmoMarketSnapshot",
  "description": "GET /ammo/market.json — 子弹行情快照。口径见 shared/API.md §1；实现 server/ammo/analyze.mjs + fetch-once.mjs。",
  "type": "object",
  "required": ["version", "fetchedAt", "generatedAt", "source", "items", "signals", "stats"],
  "properties": {
    "version": { "$ref": "#/$defs/versionKey" },
    "fetchedAt": { "type": "string", "format": "date-time" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "source": { "type": "string", "enum": ["moligod", "kkrb"] },
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "items": { "type": "array", "items": { "$ref": "#/$defs/marketItem" } },
    "signals": {
      "type": "object",
      "required": ["buy", "sell", "watch"],
      "properties": {
        "buy": { "type": "array", "items": { "$ref": "#/$defs/marketItem" } },
        "sell": { "type": "array", "items": { "$ref": "#/$defs/marketItem" } },
        "watch": { "type": "array", "items": { "$ref": "#/$defs/marketItem" } }
      }
    },
    "stats": {
      "type": "object",
      "required": ["total", "buy", "sell", "watch"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "buy": { "type": "integer", "minimum": 0 },
        "sell": { "type": "integer", "minimum": 0 },
        "watch": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "versionKey": {
      "description": "12 位分钟档 YYYYMMDDHHmm（moligod）或 10 位小时档 YYYYMMDDHH（kkrb）",
      "type": "string",
      "pattern": "^[0-9]{10}([0-9]{2})?$"
    },
    "curvePoint": {
      "description": "[时间键, 价格]，时间键同 versionKey 双格式，按升序",
      "type": "array",
      "prefixItems": [{ "$ref": "#/$defs/versionKey" }, { "type": "number", "exclusiveMinimum": 0 }],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "signal": { "type": "string", "enum": ["BUY", "WATCH", "SELL", "WAIT"] },
    "marketItem": {
      "type": "object",
      "required": ["name", "current", "taxRate", "curve", "rank", "signal"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "grade": { "type": ["integer", "null"], "minimum": 1, "maximum": 6 },
        "pic": { "type": ["string", "null"] },
        "current": { "type": ["number", "null"] },
        "taxRate": { "type": "number", "minimum": 0, "maximum": 0.5 },
        "curve": { "type": "array", "items": { "$ref": "#/$defs/curvePoint" } },
        "rank": {
          "description": "现价在 7 天曲线中的分位；null = 数据不足（曲线 <24 点），此时 signal 恒为 WAIT",
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "p10": { "type": "number" },
        "p25": { "type": "number" },
        "p50": { "type": "number" },
        "p75": { "type": "number" },
        "p90": { "type": "number" },
        "weekHigh": { "type": "number" },
        "weekLow": { "type": "number" },
        "targetSell": { "description": "= P75", "type": "number" },
        "netSell": { "description": "= targetSell × (1 − taxRate)", "type": "number" },
        "netHigh": { "description": "= weekHigh × (1 − taxRate)", "type": "number" },
        "profitPerRound": { "description": "= netSell − current", "type": "number" },
        "profitPct": { "description": "= profitPerRound / current", "type": "number" },
        "signal": { "$ref": "#/$defs/signal" },
        "reason": { "description": "仅数据不足时出现", "type": "string" }
      },
      "if": { "properties": { "rank": { "type": "null" } } },
      "then": { "properties": { "signal": { "const": "WAIT" } } }
    }
  }
}
