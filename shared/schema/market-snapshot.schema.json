{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://delta-force-map/shared/schema/market-snapshot.schema.json",
  "title": "AmmoMarketSnapshot",
  "description": "GET /ammo/market.json — 子弹行情快照。口径见 shared/API.md §1；实现 server/ammo/analyze.mjs + fetch-once.mjs。",
  "type": "object",
  "required": [
    "version",
    "fetchedAt",
    "generatedAt",
    "source",
    "items",
    "signals",
    "stats"
  ],
  "properties": {
    "version": {
      "$ref": "#/$defs/versionKey"
    },
    "fetchedAt": {
      "type": "string",
      "format": "date-time"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "enum": [
        "moligod",
        "kkrb"
      ]
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rules": {
      "description": "信号门槛展示子集（analyze.mjs RULES，随快照下发供页面渲染文案与刻度线；null = 该门槛关闭）",
      "type": "object",
      "properties": {
        "BUY_RANK_MAX": { "type": ["number", "null"] },
        "BUY_MIN_NET_PCT": { "type": ["number", "null"] },
        "WATCH_RANK_MAX": { "type": ["number", "null"] },
        "SELL_RANK_MIN": { "type": ["number", "null"] },
        "BUY_MKT_SLOPE_MIN": { "type": ["number", "null"] },
        "MAX_HOLD_H": { "type": ["number", "null"] },
        "TARGET_WINDOW_H": { "type": ["number", "null"] }
      }
    },
    "officialAnchor": {
      "description": "官方均价锚元信息（server/official/ammo-anchor.mjs 产物，fetch-once join 时带上）；null = 未跑过锚或无可用均价",
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "fetchedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "joined": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "season": {
      "description": "当前赛季日历（fetch-once 从 kkrb 活动日历接口 6h TTL 拉取）；阶段判定用 js/marketMeta.js seasonPhase；上游失败时字段缺省",
      "type": "object",
      "required": [
        "name",
        "start",
        "end"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" },
        "fetchedAt": { "type": "string", "format": "date-time" },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "start", "end"],
            "properties": {
              "name": { "type": "string" },
              "start": { "type": "string", "format": "date-time" },
              "end": { "type": "string", "format": "date-time" },
              "type": { "type": "string" }
            }
          }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/marketItem"
      }
    },
    "signals": {
      "type": "object",
      "required": [
        "buy",
        "sell",
        "watch"
      ],
      "properties": {
        "buy": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/marketItem"
          }
        },
        "sell": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/marketItem"
          }
        },
        "watch": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/marketItem"
          }
        }
      }
    },
    "stats": {
      "type": "object",
      "required": [
        "total",
        "buy",
        "sell",
        "watch"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "buy": {
          "type": "integer",
          "minimum": 0
        },
        "sell": {
          "type": "integer",
          "minimum": 0
        },
        "watch": {
          "type": "integer",
          "minimum": 0
        },
        "mktSlope48": {
          "description": "全市场 48h 斜率中位（%/h）：市场体制读数（≥0 上行 / <0 全盘阴跌）；null = 无法计算",
          "type": [
            "number",
            "null"
          ]
        }
      }
    }
  },
  "$defs": {
    "versionKey": {
      "description": "12 位分钟档 YYYYMMDDHHmm（moligod）或 10 位小时档 YYYYMMDDHH（kkrb）",
      "type": "string",
      "pattern": "^[0-9]{10}([0-9]{2})?$"
    },
    "curvePoint": {
      "description": "[时间键, 价格]，时间键同 versionKey 双格式，按升序",
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/versionKey"
        },
        {
          "type": "number",
          "exclusiveMinimum": 0
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "signal": {
      "type": "string",
      "enum": [
        "BUY",
        "WATCH",
        "SELL",
        "WAIT"
      ]
    },
    "marketItem": {
      "description": "子弹行情条目 = marketItemCore + 弹药品级约束（grade 1–6 或 null）。雷达全品类条目另复用 core 并放宽 grade（枪械等无品质物品上游给 0），见 radar-snapshot.schema.json#/$defs/radarItem",
      "allOf": [
        {
          "$ref": "#/$defs/marketItemCore"
        },
        {
          "properties": {
            "grade": {
              "description": "弹药品级 1–6；null = 上游未给",
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 6
            }
          }
        }
      ]
    },
    "marketItemCore": {
      "description": "analyzeItem 产出的行情条目公共形状（不含 grade 取值范围——由 marketItem / radarItem 各自按品类约束）",
      "type": "object",
      "required": [
        "name",
        "current",
        "taxRate",
        "curve",
        "rank",
        "signal"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "grade": {
          "type": [
            "integer",
            "null"
          ]
        },
        "pic": {
          "type": [
            "string",
            "null"
          ]
        },
        "current": {
          "type": [
            "number",
            "null"
          ]
        },
        "taxRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        },
        "curve": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/curvePoint"
          }
        },
        "rank": {
          "description": "现价在 7 天曲线中的分位；null = 数据不足（曲线 <24 点），此时 signal 恒为 WAIT",
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "p10": {
          "type": "number"
        },
        "p25": {
          "type": "number"
        },
        "p50": {
          "type": "number"
        },
        "p75": {
          "type": "number"
        },
        "p90": {
          "type": "number"
        },
        "weekHigh": {
          "type": "number"
        },
        "weekLow": {
          "type": "number"
        },
        "targetSell": {
          "description": "目标挂卖价 = 近 72h 体制内 P75（结构下行里 7 天 P75 是幻影目标，见 analyze.mjs 回测口径）",
          "type": "number"
        },
        "netSell": {
          "description": "= targetSell × (1 − taxRate)",
          "type": "number"
        },
        "netHigh": {
          "description": "= weekHigh × (1 − taxRate)",
          "type": "number"
        },
        "profitPerRound": {
          "description": "= netSell − current",
          "type": "number"
        },
        "profitPct": {
          "description": "= profitPerRound / current",
          "type": "number"
        },
        "signal": {
          "$ref": "#/$defs/signal"
        },
        "reason": {
          "description": "仅数据不足时出现",
          "type": "string"
        },
        "p75Local": {
          "description": "近 72h 曲线 P75（体制内目标锚）",
          "type": "number"
        },
        "slope48": {
          "description": "近 48h 最小二乘斜率（%/h，相对区间均值归一）；BUY 需 ≥ +0.02，SELL 动量守则 > 0.05 不催卖",
          "type": "number"
        },
        "lowAgeH": {
          "description": "7 天最低价距今小时数（BUY 需 ≥12h：止跌确认）",
          "type": "number"
        },
        "bounceOffLow": {
          "description": "现价相对 7 天低点离底幅度（BUY 需 ≥ 0.03）",
          "type": "number"
        },
        "stopLoss": {
          "description": "止损位 = max(7天低点×0.97, 现价×0.95)；跌破结构破位建议离场",
          "type": "number"
        },
        "maxHoldH": {
          "description": "建议最长持有小时数（168 = 7 天）",
          "type": "number"
        },
        "chg24h": {
          "description": "现价相对 24h 前的涨跌幅；null = 曲线不足 25 点",
          "type": [
            "number",
            "null"
          ]
        },
        "chg7d": {
          "description": "现价相对窗口首点（约 7 天前）的涨跌幅",
          "type": [
            "number",
            "null"
          ]
        },
        "official": {
          "description": "官方均价参照（腾讯 AMS 352246 avg_buyprice，fetch-once 从 data/ammo/official-anchor.json join，旁路参照不进任何信号）；无锚时字段不出现",
          "type": "object",
          "required": [
            "avg",
            "dev"
          ],
          "properties": {
            "avg": {
              "description": "官方近期平均成交价",
              "type": "number",
              "exclusiveMinimum": 0
            },
            "dev": {
              "description": "= (current − avg) / avg，4 位小数；|dev| > 0.15 提示数据可疑",
              "type": "number"
            },
            "at": {
              "description": "锚抓取时刻 ISO 字串；null = 锚文件无 fetchedAt",
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "trade": {
          "description": "军需处兑换折算（kkrb 军需处兑换接口 10min TTL 拉取，旁路参照不进任何信号）；仅约 7 种可兑换弹有此字段",
          "type": "object",
          "required": [
            "costPerRound",
            "perCount",
            "marketPrice"
          ],
          "properties": {
            "costPerRound": {
              "description": "材料市价折算成本 / 发",
              "type": "number",
              "minimum": 0
            },
            "perCount": {
              "description": "一次兑换产出的发数",
              "type": "integer",
              "minimum": 1
            },
            "marketPrice": {
              "description": "上游同刻的交易行现价 / 发",
              "type": "number",
              "exclusiveMinimum": 0
            },
            "materials": {
              "description": "兑换材料清单（名称 / 数量 / 市价单价）",
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "count", "perPrice"],
                "properties": {
                  "name": { "type": "string" },
                  "count": { "type": "integer", "minimum": 1 },
                  "perPrice": { "type": "number", "minimum": 0 }
                }
              }
            },
            "version": {
              "description": "上游数据版本（YYYYMMDDHHmm）",
              "type": "string"
            }
          }
        }
      },
      "if": {
        "properties": {
          "rank": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "signal": {
            "const": "WAIT"
          }
        }
      }
    }
  }
}
