{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://delta-force-map/shared/schema/secrets-snapshot.schema.json",
  "title": "SecretsSnapshot",
  "description": "GET /secrets/secrets.json — 每日地图密码快照。口径见 shared/API.md §1.4；实现 server/secrets/secrets.mjs（主源腾讯官方 AMS dfm/center.day.secret，兜底 moligod /api/daily-secrets）。密码北京时间每天 0 点轮换，日期即版本；位置图为官方 WeGame 助手静态资源，本地打包于 apps/web/public/secrets/img/。",
  "type": "object",
  "required": ["version", "fetchedAt", "date", "source", "items", "stats"],
  "properties": {
    "version": {
      "$ref": "#/$defs/versionKey"
    },
    "fetchedAt": {
      "type": "string",
      "format": "date-time"
    },
    "date": {
      "description": "北京墙钟日期（= version 的连字形式，页面「今日」判定用）",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "source": {
      "description": "实际服务的源：official-ams 腾讯官方 / moligod-mirror 官方维护期兜底",
      "enum": ["official-ams", "moligod-mirror"]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/secretItem"
      }
    },
    "stats": {
      "type": "object",
      "required": ["total"],
      "properties": {
        "total": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "$defs": {
    "versionKey": {
      "description": "8 位日期档 YYYYMMDD（北京墙钟；密码 0 点轮换，日期即版本）",
      "type": "string",
      "pattern": "^[0-9]{8}$"
    },
    "secretItem": {
      "type": "object",
      "required": ["mapId", "mapName", "secret", "img"],
      "properties": {
        "mapId": {
          "description": "上游地图编号（1..6 与本地位置图编号一致；新增地图开放集）",
          "type": "integer",
          "minimum": 1
        },
        "mapName": {
          "description": "地图官方中文名",
          "type": "string",
          "minLength": 1
        },
        "secret": {
          "description": "4 位数字密码（字符串透传，保留前导零余地）",
          "type": "string",
          "pattern": "^[0-9A-Za-z]{3,8}$"
        },
        "img": {
          "description": "本地打包的位置图相对路径（相对站点根）；mapId 1..6 之外为 null（暂无图）",
          "type": ["string", "null"],
          "pattern": "^secrets/img/password[0-9]+\\.jpg$"
        }
      }
    }
  }
}
