{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://delta-force-map/shared/schema/sse-events.schema.json",
  "title": "LiveEvents",
  "description": "GET /events（text/event-stream）各命名事件的 data 负载。事件为轻量 ping：客户端比较 version，前进才重新 GET 对应快照。注释行 `: ping` 每 25s 一次为心跳。实现 server/ammo/live.mjs + server/server.mjs。",
  "oneOf": [
    {
      "title": "hello",
      "description": "连接建立即发：当前盘上弹药快照的元信息（冷启动尚无快照时字段可为 null）",
      "type": "object",
      "required": ["version", "source", "generatedAt"],
      "properties": {
        "version": { "oneOf": [{ "$ref": "market-snapshot.schema.json#/$defs/versionKey" }, { "type": "null" }] },
        "source": { "type": ["string", "null"], "enum": ["moligod", "kkrb", null] },
        "generatedAt": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    {
      "title": "market",
      "description": "弹药快照落盘后广播",
      "type": "object",
      "required": ["version", "source", "generatedAt"],
      "properties": {
        "version": { "$ref": "market-snapshot.schema.json#/$defs/versionKey" },
        "source": { "type": "string", "enum": ["moligod", "kkrb"] },
        "generatedAt": { "type": "string", "format": "date-time" }
      }
    },
    {
      "title": "radar",
      "description": "雷达快照落盘后广播",
      "type": "object",
      "required": ["version", "total", "anomaly", "buy", "sell"],
      "properties": {
        "version": { "$ref": "market-snapshot.schema.json#/$defs/versionKey" },
        "total": { "type": "integer", "minimum": 0 },
        "anomaly": { "type": "integer", "minimum": 0 },
        "buy": { "type": "integer", "minimum": 0 },
        "sell": { "type": "integer", "minimum": 0 }
      }
    },
    {
      "title": "craft",
      "description": "特勤处制造快照落盘后广播",
      "type": "object",
      "required": ["version", "total", "complete", "profitable"],
      "properties": {
        "version": { "$ref": "market-snapshot.schema.json#/$defs/versionKey" },
        "total": { "type": "integer", "minimum": 0 },
        "complete": { "type": "integer", "minimum": 0 },
        "profitable": { "type": "integer", "minimum": 0 }
      }
    },
    {
      "title": "secrets",
      "description": "每日密码快照内容变化时广播（日更数据，内容不变的轮次不广播）",
      "type": "object",
      "required": ["version", "total", "source"],
      "properties": {
        "version": { "type": "string", "pattern": "^\\d{8}$", "description": "北京日期 YYYYMMDD（密码每天 0 点轮换，日期即版本）" },
        "total": { "type": "integer", "minimum": 0 },
        "source": { "type": "string", "enum": ["official-ams", "moligod-mirror"] }
      }
    },
    {
      "title": "tradehouse",
      "description": "交易行全量 / 指数快照落盘后广播（交易行全览与市场指数两页共用版本门控；战备差价页小时级走轮询不挂此事件）",
      "type": "object",
      "required": ["version", "total"],
      "properties": {
        "version": { "$ref": "market-snapshot.schema.json#/$defs/versionKey" },
        "total": { "type": "integer", "minimum": 0 },
        "indexAll": { "description": "总览指数 level（可空：篮子为空）", "type": ["number", "null"] },
        "loadoutTotal": { "description": "本轮战备差价条数；null = 上游失败保留旧档", "type": ["integer", "null"], "minimum": 0 }
      }
    }
  ]
}
