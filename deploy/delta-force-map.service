# delta-force-map.service — systemd 常驻单元（阿里云 ECS / 任意 Linux）
#
# 安装：
#   sudo cp deploy/delta-force-map.service /etc/systemd/system/
#   # 按实际路径/用户改 WorkingDirectory 与 User 后：
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now delta-force-map
#   journalctl -u delta-force-map -f     # 看实时日志
#
# 说明：服务进程 = 静态站 + 实时行情抓取 + SSE，单进程零依赖（只要 node）；
# Restart=always 保证崩溃自愈；重启不丢曲线缓存（启动序列从 market.json 预热）。

[Unit]
Description=Delta Force Map - site + live market (static + SSE)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dfmap
Group=dfmap
WorkingDirectory=/opt/delta-force-map
ExecStart=/usr/local/bin/node scripts/server.mjs
Environment=PORT=8080
Environment=HOST=0.0.0.0
Restart=always
RestartSec=5
# 日志进 journald；进程无需特权（8080 非特权端口，上 80/443 用 nginx 反代）
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
