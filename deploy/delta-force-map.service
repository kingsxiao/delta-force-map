# delta-force-map.service — systemd 常驻单元
#
# 本文件与线上阿里云 ECS 的 /etc/systemd/system/delta-force-map.service 保持一致，
# deploy/update.sh 会用 cmp 比对后自动同步，请勿只改一边。
#
# 首次安装：
#   sudo cp deploy/delta-force-map.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now delta-force-map
#   journalctl -u delta-force-map -f     # 看实时日志
#
# 说明：服务进程 = 静态站 + 实时行情抓取 + SSE，单进程零依赖（只要 node）；
# Restart=always 保证崩溃自愈；重启不丢曲线缓存（启动序列从 market.json 预热）。
# 内存紧张的小机器（1.8G）：NODE_OPTIONS 限制 node 堆 + OOMScoreAdjust=200，
# 内存吃紧时优先杀本服务而不是拖垮整机。

[Unit]
Description=Delta Force Map - site + live market (static + SSE)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/delta-force-map
ExecStart=/root/.nvm/versions/node/v24.15.0/bin/node server/server.mjs
Environment=PORT=8080
Environment=HOST=0.0.0.0
Environment=PATH=/root/.nvm/versions/node/v24.15.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# 内存紧张的小机器：限制 node 堆，优先被 OOM 杀自己而不是拖垮整机
Environment=NODE_OPTIONS=--max-old-space-size=256
OOMScoreAdjust=200
Restart=always
RestartSec=5
# 日志进 journald；8080 非特权端口，上 80/443 用 nginx 反代
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
