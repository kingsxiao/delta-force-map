{
  "name": "delta-force-map",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "cd apps/web && vite",
    "build": "cd apps/web && vite build",
    "preview": "cd apps/web && vite preview",
    "serve": "node server/server.mjs",
    "refresh": "node server/refresh-data.mjs",
    "ammo:fetch": "node server/ammo/fetch-once.mjs",
    "ammo:monitor": "node server/ammo/monitor.mjs",
    "ammo:live": "node server/ammo/live.mjs",
    "ammo:selftest": "node server/ammo/selftest.mjs",
    "radar:fetch": "node server/market/radar.mjs --once",
    "radar:monitor": "node server/market/radar.mjs",
    "radar:selftest": "node server/market/selftest.mjs",
    "export:ios": "node server/export-ios-data.mjs",
    "dfttk:snapshot": "node server/dfttk/snapshot-balance.mjs",
    "ios:archive": "bash deploy/ios-archive.sh"
  },
  "dependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "vite": "^7.0.0"
  }
}
